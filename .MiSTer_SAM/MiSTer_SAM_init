#!/bin/bash
# Existing user-startup entry; the engine owns its workers and cleanup.
entry=/media/fat/Scripts/MiSTer_SAM_on.sh
case "${1,,}" in
    start) exec "$entry" bootstart ;;
    quickstart) exec "$entry" start ;;
    stop) tmux kill-session -t MCP 2>/dev/null; exec "$entry" stop ;;
    restart) tmux kill-session -t MCP 2>/dev/null; "$entry" stop; exec "$entry" bootstart ;;
    *) echo 'Usage: MiSTer_SAM_init {start|quickstart|stop|restart}' >&2; exit 1 ;;
esac
